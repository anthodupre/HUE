{
  "id": "./",
  "name": "Iris",
  "short_name": "Iris",
  "description": "Control your Philips Hue Iris over Bluetooth: colors, scenes, Christmas effects, timers and schedules.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0b0a09",
  "theme_color": "#0b0a09",
  "categories": ["lifestyle", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Christmas lights", "url": "./?do=twinkle", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Fireplace", "url": "./?do=fireplace", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Focus", "url": "./?do=focus", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Turn off", "url": "./?do=off", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
